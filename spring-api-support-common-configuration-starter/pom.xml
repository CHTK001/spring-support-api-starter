<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-api-starter</artifactId>
        <version>4.0.0</version>
    </parent>

    <artifactId>spring-api-support-common-configuration-starter</artifactId>
    <description>系统公共配置</description>
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 验证API - 配置类需要 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- 基础公共模块 - 必需 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- 以下依赖改为 provided，由使用方决定是否引入 -->
        
        <!-- Socket.IO 支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-io-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis 支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 数据源支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 邮件支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-email-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OAuth客户端支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 深度学习支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-deeplearning-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Redis支持 - 可选 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-redis-starter</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>
</project>
