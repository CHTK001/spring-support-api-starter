panel/
/rag-upload
org/
*bak
logs/!/patch/
/.runtime/
/system-ui-inspect.png
*.code-workspace
.codex/
.runtime/
logs/
tmp/
# ignore e2e test temporal files
e2e-crud-*
e2e-flow-*
e2e-test-*
submit-*
e2e-full-test.mjs
# ignore test screenshots and temp files
*.png
*.jpeg
*.jpg
*.gif
run_backend.sh
run_system.sh
pipeline-management
.cache/
**/data/monitor.*
# build artifacts (only under target/, not source code)
target/**/BOOT-INF/
target/**/META-INF/
target/**/com/


# data directories
# 锚定到仓库根：只排除顶层可能生成的 docs/ 输出目录。
# 原来写的是 `docs/`，会连各模块自己的 docs/ 一起忽略，导致模块文档
# （如 spring-api-support-collect-starter/docs/rest-api.md）无法入库。
data/
/docs/

# H2 database
*.mv.db
*.trace.db

# datalake test pipelines
**/crud-test-pipe
**/test-pipeline-*
**/weather-test-pipeline

# test backend artifacts
test/**/node_modules/
test/**/sys
test/**/*.log.*
test/**/ssh_payload.json
test/**/submit-*
test/**/e2e-*

# test demo starters
test/**/spring-api-support-common-music-demo/
test/**/spring-api-support-soft-test-starter/

# tooling
.opencode/
.playwright-mcp/

# temporary files
\!TEMP_FILE!
null

# backup files
*.bak*

# build artifacts (outside target/)
BOOT-INF/
/META-INF/
test/*/META-INF/
test/*/com/

# dependencies
node_modules/

# temporary python scripts
check_javadoc.py
jdcheck.py
scan.py
scan_method_javadoc.py
scan_script.py
scan_script2.py
scan_script4.py
scan_script5.py
test_script.py

# 运行时输出/探针系统文件
sys
!**/src/main/java/sys**
hs_err_pid*.log
replay_pid*.log
spy.log
*.log.gz

# 崩溃/回放/JVM dump 残留
replay_pid*
hs_err*
thread-dump*
__pycache__/
*.orig

# 部署脚本例外：package.ps1 是 Windows 开发机上跑打包的正式交付物
# （本仓无 bash，package.sh 在 Windows 上不可用），故显式纳入版本控制，
# 覆盖上面 *.ps1 的默认忽略。纯 ASCII，避免 PS 5.1 按 ANSI 解析中文报错。
!spring-api-support-oauth-starter/deploy/package.ps1
