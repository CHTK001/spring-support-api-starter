    <select id="roleMenu" resultType="com.chua.starter.admin.entity.SysMenu">
        SELECT
            sm.*,
            t.role
        FROM
            sys_menu sm
                LEFT JOIN (
                SELECT
                    sm.menu_id,
                    GROUP_CONCAT( sr.role_code ) role
                FROM
                    sys_menu sm
                        LEFT JOIN sys_role_menu srm ON sm.menu_id = srm.menu_id
                        LEFT JOIN sys_role sr ON sr.role_id = srm.role_id
                GROUP BY
                    sm.menu_id
            ) t ON sm.menu_id = t.menu_id

        ORDER BY sm.menu_sort
    </select>
