<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.admin.mapper.SysOperateLoggerMapper">
    <select id="near" resultType="com.chua.starter.admin.pojo.LogStaticVO">
        SELECT
            count( log_day ) cnt,
            log_day,
            log_status
        FROM
            `sys_logger`
        WHERE
            log_day BETWEEN #{startTime} AND #{endTime}
        GROUP BY
            log_day,
            log_status
    </select>
</mapper>
