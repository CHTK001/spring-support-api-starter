<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-api-parent</artifactId>
        <version>4.0.0.41</version>
    </parent>

    <artifactId>spring-api-support-datalake-starter</artifactId>
    <name>Spring API Support Datalake Starter - 数据中台 ProtocolServer API</name>
    <description>数据中台 REST API 层（基于 ProtocolServer）: Pipeline管理/数据查询/订阅管理/监控/死信队列</description>

    <dependencies>
        <!-- 数据中台核心 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datalake-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- ProtocolServer + Json + ReturnResult -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- HTTP ProtocolServer 实现 (smart-http, 保留用于兼容) -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-protocol-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- HTTP ProtocolServer 实现 (Netty, 高优先级) -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-netty-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- GuavaDispatcherProvider -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-task-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
