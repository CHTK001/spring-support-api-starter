<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-api-parent</artifactId>
    <version>4.0.0.51</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>spring-api-support-system-starter</artifactId>
  <description>平台端</description>
  <dependencies>
    <!-- datasearch 在顶层 pom 直接依赖，此处显式重声明以排除其传递的 sqlite 链 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-datasearch-starter</artifactId>
      <version>${utils.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.xerial</groupId>
          <artifactId>sqlite-jdbc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-sqlite-starter</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-native-sqlite</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.whvcse</groupId>
      <artifactId>easy-captcha</artifactId>
      <version>1.6.2</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-job-starter</artifactId>
    </dependency>
    <!-- AI 提供商管理内嵌：引入 ai-starter，其 /v2/ai/**、/v2/models 等端点随本后端一并暴露
         （context-path /system/api 下即 /system/api/v2/**）。系统平台「AI 提供商管理」菜单
         以内嵌 pages/ai 的模型管理页呈现，页面 apiService 以 /v2 为基址（前端 dev 已把 /v2
         代理到本后端并补 context-path），故后端必须自带 ai 模块，与采集调度系统口径一致。
         注意：需配套 AI 表（ai-starter 的 db/init/V1.0__init_all_ai.sql）。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-ai-starter</artifactId>
    </dependency>
    <!--
      脚本片段（GLUE_GROOVY）引擎：提供 ScriptProvider SPI 的 groovy 实现。
      声明为 optional：job-starter 本身不含任何脚本引擎（缺引擎时任务会记可读的 FAILURE），
      但本应用对外提供「调度管理」入口，不装引擎的话建了脚本任务也只能报
      「脚本引擎 'groovy' 不可用」。optional 使下游依赖本模块的模块不会被动带上 groovy。
    -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-groovy-starter</artifactId>
      <version>${utils.version}</version>
      <optional>true</optional>
      <exclusions>
        <!--
          utils-support-groovy-starter 依赖的是 org.apache.groovy:groovy-all，
          那是个全量聚合包，会把 Groovy 发布的一切都拖进来。其中 groovy-ant 与
          groovy-test-junit5 是构建/测试工具，却以 compile 作用域进了 runtime，
          连带 29 个 jar、约 8.5MB 进了生产的 lib/（ant、ivy、javaparser、qdox、
          asm、jline、jansi、picocli、整套 junit）。运行期用不到，排除掉。
        -->
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-ant</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-test-junit5</artifactId>
        </exclusion>
        <!-- groovy-console 是 Swing REPL、groovy-groovydoc 是文档生成器、
             groovy-cli-picocli 是命令行前端、groovy-swing 是 Swing 扩展：
             同样只被 groovy-all 拖进来，生产服务运行期一个都用不到。
             它们连带 19 个 jar、约 5.3MB（javaparser、asm、ivy、jline、jansi、picocli）。 -->
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-console</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-groovydoc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-cli-picocli</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-swing</artifactId>
        </exclusion>
        <!-- groovy-docgenerator 带出 qdox，groovy-groovysh 带出整套 jline/jansi，
             合计还有 11 个 jar、约 2.3MB 的构建期依赖，同样排除。 -->
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-docgenerator</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.groovy</groupId>
          <artifactId>groovy-groovysh</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-system-starter</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-simple</artifactId>
        </exclusion>
        <exclusion>
          <groupId>it.ozimov</groupId>
          <artifactId>embedded-redis</artifactId>
        </exclusion>
        <!-- Armeria OAuth 协议：默认已改 tcp，无需 armeria + netty-all (~30MB) -->
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-armeria-starter</artifactId>
        </exclusion>
        <!-- sqlite：eduai 用 MySQL/H2，不需要嵌入式 sqlite (~11.4MB) -->
        <exclusion>
          <groupId>org.xerial</groupId>
          <artifactId>sqlite-jdbc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-sqlite-starter</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-native-sqlite</artifactId>
        </exclusion>
        <!-- datasearch 链：utils-support-datasource-starter 也带 sqlite -->
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-datasource-starter</artifactId>
        </exclusion>
        <!-- datasearch 链也带 sqlite -->
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-datasearch-starter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-service-starter</artifactId>
    </dependency>
    <!-- 文件存储唯一底座：sys_file_system* 那套无实现，收敛到本模块 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-filesystem-starter</artifactId>
    </dependency>
    <!--
      Office → PDF 转换的 SPI 实现（Aspose）。
      没有它时 FileConvertSystem 只有接口没有实现，?format=pdf 会静默无效
      （实测：docx/xls 请求 format=pdf 仍回原字节，因为根本没有转换器可调）。
      随 api jar 一起部署到 lib/。
    -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-aspose-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-common-starter</artifactId>
    </dependency>
    <!-- 消息渠道 SPI 实现：email(SMTP) 与 webhook(钉钉/企业微信/自建网关) -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-email-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-webhook-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- 注释掉 eduai-starter，因为它需要 MessageTemplate bean，但我们不需要这个功能
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-eduai-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-tenant-starter</artifactId>
    </dependency>
    <!-- 系统指标（/api/apm/**）：控制器与数据源路由由 monitor 模块的
         SystemMetricAutoConfiguration 自动装配提供，本模块只需引入依赖，
         无需在 SystemApplication 的 scanBasePackages 里补扫其包。
         版本未纳入父 POM 的 dependencyManagement，故显式声明 ${project.version}。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-monitor-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasource-starter</artifactId>
      <exclusions>
        <!-- sqlite：eduai 用 MySQL/H2，排除嵌入式 sqlite 链 (~11.4MB) -->
        <exclusion>
          <groupId>org.xerial</groupId>
          <artifactId>sqlite-jdbc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-sqlite-starter</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-native-sqlite</artifactId>
        </exclusion>
        <!-- armeria 兜底（datasource 不引 armeria，仅保险） -->
        <exclusion>
          <groupId>com.chua</groupId>
          <artifactId>utils-support-armeria-starter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- 数据源中心（含 DbConsoleController /ms/monitor/db/**）：让系统端自带数据库管理器 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasource-hub-starter</artifactId>
      <version>${module.version}</version>
    </dependency>
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-redis-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson</artifactId>
      <version>3.32.0</version>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <version>3.8.7</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-achievement-starter</artifactId>
      <version>4.0.0.51</version></dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-signin-starter</artifactId>
      <version>4.0.0.51</version></dependency>
    <!-- utils-support-smtp-starter does not exist yet, commented out -->
    <!--
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-smtp-starter</artifactId>
    </dependency>
    -->
    <!-- spring-support-protocol-starter depends on ai-starter with missing classes, commented out for now -->
    <!--
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-protocol-starter</artifactId>
    </dependency>
    -->
    <!-- 正式嵌入式数据库适配：系统初始化器及数据脚本包含完整 H2 运行分支 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.252</version>
      <scope>runtime</scope>
    </dependency>
</dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
        <release>25</release>
        <proc>full</proc>
<compilerArgs>
          <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
          <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
          <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
          <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
        </compilerArgs>
        <annotationProcessorPaths>
          <path>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
          </path>
        </annotationProcessorPaths>
      </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven-antrun-plugin.version}</version>
        <executions>
          <execution>
            <id>clean-runtime-layout</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${project.build.directory}/lib" quiet="true" />
                <delete dir="${project.build.directory}/config" quiet="true" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.chua.starter.system.SystemApplication</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
            <manifestEntries>
              <Class-Path>config/</Class-Path>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <excludeTransitive>false</excludeTransitive>
              <stripVersion>false</stripVersion>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/config</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <includes>
                    <include>*.yml</include>
                    <include>*.yaml</include>
                    <include>*.properties</include>
                    <include>logback*.xml</include>
                    <include>log4j2*.xml</include>
                    <include>config/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
