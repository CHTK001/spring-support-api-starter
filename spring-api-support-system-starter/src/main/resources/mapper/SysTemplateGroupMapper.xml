<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.system.mapper.SysTemplateGroupMapper">

  <select id="selectPageByRoles" resultType="com.chua.starter.system.entity.SysTemplateGroup">
    SELECT
      *
    FROM sys_template_group
    <where>
      <if test="query.sysTemplateGroupCode != null and query.sysTemplateGroupCode != ''">
        AND sys_template_group_code LIKE CONCAT('%',#{query.sysTemplateGroupCode},'%')
      </if>

      <if test="query.sysTemplateGroupName != null and query.sysTemplateGroupName != ''">
        AND sys_template_group_name LIKE CONCAT('%',#{query.sysTemplateGroupName},'%')
      </if>

      <if test="isAdmin == null or !isAdmin">
        AND sys_template_group_delete = 0
      </if>
    </where>
  </select>
</mapper>