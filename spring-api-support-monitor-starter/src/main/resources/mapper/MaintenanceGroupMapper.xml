<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.monitor.mapper.MaintenanceGroupMapper">
    <!-- 基础列 -->
    <sql id="Base_Column_List">
        maintenance_group_id, maintenance_group_name, maintenance_group_description,
        maintenance_group_enabled, maintenance_group_create_time, maintenance_group_update_time
    </sql>

    <!-- 获取维护组列表 -->
    <select id="selectMasterList" resultType="com.chua.starter.monitor.entity.MaintenanceGroup">
        SELECT
        <include refid="Base_Column_List" />
        FROM t_maintenance_group
        <where>
            <if test="enabled != null">
                maintenance_group_enabled = #{enabled}
            </if>
        </where>
        ORDER BY maintenance_group_create_time DESC
    </select>

    <!-- 根据ID获取维护组 -->
    <select id="selectMasterById" resultType="com.chua.starter.monitor.entity.MaintenanceGroup">
        SELECT
        <include refid="Base_Column_List" />
        FROM t_maintenance_group
        WHERE maintenance_group_id = #{maintenanceGroupId}
    </select>
</mapper> 