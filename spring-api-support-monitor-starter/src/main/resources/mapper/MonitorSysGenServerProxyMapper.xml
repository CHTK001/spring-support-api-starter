<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.monitor.starter.mapper.MonitorSysGenServerProxyMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.chua.starter.monitor.starter.entity.MonitorSysGenServerProxy">
        <id column="monitor_sys_gen_server_proxy_id" property="monitorSysGenServerProxyId" />
        <result column="monitor_sys_gen_server_id" property="monitorSysGenServerId" />
        <result column="monitor_sys_gen_server_proxy_type" property="monitorSysGenServerProxyType" />
        <result column="monitor_sys_gen_server_proxy_config" property="monitorSysGenServerProxyConfig" />
        <result column="monitor_sys_gen_server_proxy_enabled" property="monitorSysGenServerProxyEnabled" />
        <result column="monitor_sys_gen_server_proxy_status" property="monitorSysGenServerProxyStatus" />
        <result column="monitor_sys_gen_server_proxy_last_connect_time" property="monitorSysGenServerProxyLastConnectTime" />
        <result column="monitor_sys_gen_server_proxy_connection_error" property="monitorSysGenServerProxyConnectionError" />
        <result column="monitor_sys_gen_server_proxy_url" property="monitorSysGenServerProxyUrl" />
        <result column="monitor_sys_gen_server_proxy_create_time" property="monitorSysGenServerProxyCreateTime" />
        <result column="monitor_sys_gen_server_proxy_update_time" property="monitorSysGenServerProxyUpdateTime" />
        <result column="monitor_sys_gen_server_proxy_remark" property="monitorSysGenServerProxyRemark" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        monitor_sys_gen_server_proxy_id,
        monitor_sys_gen_server_id,
        monitor_sys_gen_server_proxy_type,
        monitor_sys_gen_server_proxy_config,
        monitor_sys_gen_server_proxy_enabled,
        monitor_sys_gen_server_proxy_status,
        monitor_sys_gen_server_proxy_last_connect_time,
        monitor_sys_gen_server_proxy_connection_error,
        monitor_sys_gen_server_proxy_url,
        monitor_sys_gen_server_proxy_create_time,
        monitor_sys_gen_server_proxy_update_time,
        monitor_sys_gen_server_proxy_remark
    </sql>

    <!-- 根据服务器ID查询代理关联列表 -->
    <select id="selectByServerId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM monitor_sys_gen_server_proxy
        WHERE monitor_sys_gen_server_id = #{serverId}
        ORDER BY monitor_sys_gen_server_proxy_create_time DESC
    </select>

    <!-- 根据代理ID查询服务器关联列表 -->
    <select id="selectByProxyId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM monitor_sys_gen_server_proxy
        WHERE monitor_sys_gen_server_proxy_id = #{proxyId}
        ORDER BY monitor_sys_gen_server_proxy_create_time DESC
    </select>

    <!-- 根据服务器ID和代理类型查询代理关联 -->
    <select id="selectByServerIdAndProxyType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM monitor_sys_gen_server_proxy
        WHERE monitor_sys_gen_server_id = #{serverId}
        AND monitor_sys_gen_server_proxy_type = #{proxyType}
        LIMIT 1
    </select>

    <!-- 批量更新代理状态 -->
    <update id="batchUpdateStatus">
        UPDATE monitor_sys_gen_server_proxy
        SET monitor_sys_gen_server_proxy_status = #{status},
            monitor_sys_gen_server_proxy_update_time = NOW()
        WHERE monitor_sys_gen_server_proxy_id IN
        <foreach collection="proxyIds" item="proxyId" open="(" separator="," close=")">
            #{proxyId}
        </foreach>
    </update>

    <!-- 根据服务器ID删除代理关联 -->
    <delete id="deleteByServerId">
        DELETE FROM monitor_sys_gen_server_proxy
        WHERE monitor_sys_gen_server_id = #{serverId}
    </delete>



</mapper>
