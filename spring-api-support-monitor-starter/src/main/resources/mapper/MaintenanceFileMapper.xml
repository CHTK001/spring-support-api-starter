<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.monitor.mapper.MaintenanceFileMapper">
    <!-- 基础列 -->

    <!-- 获取文件列表 -->
    <select id="selectFilesByGroupId" resultType="com.chua.starter.monitor.entity.MaintenanceFile">
        SELECT *
        FROM t_maintenance_file
        <where>
            <if test="groupId != null">
                maintenance_group_id = #{groupId}
            </if>
            <if test="status != null">
                AND maintenance_file_status = #{status}
            </if>
        </where>
        ORDER BY maintenance_file_create_time DESC
    </select>

    <!-- 根据ID获取文件 -->
    <select id="selectFileById" resultType="com.chua.starter.monitor.entity.MaintenanceFile">
        SELECT *
        FROM t_maintenance_file
        WHERE maintenance_file_id = #{maintenanceFileId}
    </select>
</mapper> 