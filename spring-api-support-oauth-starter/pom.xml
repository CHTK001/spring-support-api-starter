<?xml version='1.0' encoding='utf-8'?>
<ns0:project xmlns:ns0="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <ns0:modelVersion>4.0.0</ns0:modelVersion>
    <ns0:parent>
        <ns0:groupId>com.chua</ns0:groupId>
        <ns0:artifactId>spring-support-api-parent</ns0:artifactId>
        <ns0:version>${project.version}</ns0:version>
    </ns0:parent>

    <ns0:artifactId>spring-api-support-oauth-starter</ns0:artifactId>
    <ns0:description>OAuth单点登录系统</ns0:description>

    <ns0:properties>
        <ns0:maven.compiler.source>25</ns0:maven.compiler.source>
        <ns0:maven.compiler.target>25</ns0:maven.compiler.target>
        <ns0:netty.version>4.1.116.Final</ns0:netty.version>
        <ns0:project.build.sourceEncoding>UTF-8</ns0:project.build.sourceEncoding>
        <ns0:grpc.version>1.58.0</ns0:grpc.version>
        <ns0:protobuf.version>3.24.4</ns0:protobuf.version>
        <ns0:protoc.version>3.24.4</ns0:protoc.version>
    </ns0:properties>

    <ns0:dependencies>
        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-api-support-devops-starter</ns0:artifactId>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>org.springframework.boot</ns0:groupId>
            <ns0:artifactId>spring-boot-starter-web</ns0:artifactId>
            <ns0:exclusions>
                <ns0:exclusion>
                    <ns0:groupId>org.springframework.boot</ns0:groupId>
                    <ns0:artifactId>spring-boot-starter-tomcat</ns0:artifactId>
                </ns0:exclusion>
            </ns0:exclusions>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-api-support-common-system-starter</ns0:artifactId>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.github.whvcse</ns0:groupId>
            <ns0:artifactId>easy-captcha</ns0:artifactId>
            </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-swagger-starter</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>org.apache.commons</ns0:groupId>
            <ns0:artifactId>commons-lang3</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>joda-time</ns0:groupId>
            <ns0:artifactId>joda-time</ns0:artifactId>
            </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-api-support-common-service-starter</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.fasterxml.jackson.dataformat</ns0:groupId>
            <ns0:artifactId>jackson-dataformat-xml</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.alibaba</ns0:groupId>
            <ns0:artifactId>fastjson</ns0:artifactId>
            </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>mysql</ns0:groupId>
            <ns0:artifactId>mysql-connector-java</ns0:artifactId>
            </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>redis.clients</ns0:groupId>
            <ns0:artifactId>jedis</ns0:artifactId>
            </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>me.zhyd.oauth</ns0:groupId>
            <ns0:artifactId>JustAuth</ns0:artifactId>
            </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>io.jsonwebtoken</ns0:groupId>
            <ns0:artifactId>jjwt-api</ns0:artifactId>
            </ns0:dependency>
        <ns0:dependency>
            <ns0:groupId>io.jsonwebtoken</ns0:groupId>
            <ns0:artifactId>jjwt-impl</ns0:artifactId>
            <ns0:scope>runtime</ns0:scope>
        </ns0:dependency>
        <ns0:dependency>
            <ns0:groupId>io.jsonwebtoken</ns0:groupId>
            <ns0:artifactId>jjwt-jackson</ns0:artifactId>
            <ns0:scope>runtime</ns0:scope>
        </ns0:dependency>

        

        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-datasource-starter</ns0:artifactId>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>utils-support-armeria-starter</ns0:artifactId>
            </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>io.rsocket</ns0:groupId>
            <ns0:artifactId>rsocket-core</ns0:artifactId>
            </ns0:dependency>
        <ns0:dependency>
            <ns0:groupId>io.rsocket</ns0:groupId>
            <ns0:artifactId>rsocket-transport-netty</ns0:artifactId>
            </ns0:dependency>
        <ns0:dependency>
            <ns0:groupId>org.springframework.boot</ns0:groupId>
            <ns0:artifactId>spring-boot-starter-rsocket</ns0:artifactId>
        </ns0:dependency>
    </ns0:dependencies>

    <ns0:build>
        <ns0:plugins>
            <ns0:plugin>
                <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                <ns0:artifactId>maven-compiler-plugin</ns0:artifactId>
                <ns0:configuration>
                    <ns0:source>25</ns0:source>
                    <ns0:target>25</ns0:target>
                </ns0:configuration>
            </ns0:plugin>

            
            <ns0:plugin>
                <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                <ns0:artifactId>maven-jar-plugin</ns0:artifactId>
                <ns0:version>3.3.0</ns0:version>
                <ns0:configuration>
                    
                    <ns0:excludes>
                        <ns0:exclude>*.yml</ns0:exclude>
                        <ns0:exclude>*.yaml</ns0:exclude>
                        <ns0:exclude>*.properties</ns0:exclude>
                        <ns0:exclude>*.xml</ns0:exclude>
                        <ns0:exclude>config/**</ns0:exclude>
                    </ns0:excludes>
                    <ns0:archive>
                        <ns0:manifest>
                            <ns0:mainClass>com.chua.starter.oauth.sso.support.AuthApplication</ns0:mainClass>
                            <ns0:addClasspath>true</ns0:addClasspath>
                            <ns0:classpathPrefix>lib/</ns0:classpathPrefix>
                        </ns0:manifest>
                        <ns0:manifestEntries>
                            <ns0:Class-Path>config/</ns0:Class-Path>
                        </ns0:manifestEntries>
                    </ns0:archive>
                </ns0:configuration>
            </ns0:plugin>

            
            <ns0:plugin>
                <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                <ns0:artifactId>maven-dependency-plugin</ns0:artifactId>
                <ns0:version>3.6.1</ns0:version>
                <ns0:executions>
                    <ns0:execution>
                        <ns0:id>copy-dependencies</ns0:id>
                        <ns0:phase>package</ns0:phase>
                        <ns0:goals>
                            <ns0:goal>copy-dependencies</ns0:goal>
                        </ns0:goals>
                        <ns0:configuration>
                            <ns0:outputDirectory>${project.build.directory}/lib</ns0:outputDirectory>
                            <ns0:excludeTransitive>false</ns0:excludeTransitive>
                            <ns0:stripVersion>false</ns0:stripVersion>
                            <ns0:includeScope>runtime</ns0:includeScope>
                        </ns0:configuration>
                    </ns0:execution>
                </ns0:executions>
            </ns0:plugin>

            
            <ns0:plugin>
                <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                <ns0:artifactId>maven-resources-plugin</ns0:artifactId>
                <ns0:version>3.3.1</ns0:version>
                <ns0:executions>
                    <ns0:execution>
                        <ns0:id>copy-resources</ns0:id>
                        <ns0:phase>package</ns0:phase>
                        <ns0:goals>
                            <ns0:goal>copy-resources</ns0:goal>
                        </ns0:goals>
                        <ns0:configuration>
                            <ns0:outputDirectory>${project.build.directory}/config</ns0:outputDirectory>
                            <ns0:resources>
                                <ns0:resource>
                                    <ns0:directory>src/main/resources</ns0:directory>
                                    <ns0:includes>
                                        <ns0:include>*.yml</ns0:include>
                                        <ns0:include>*.yaml</ns0:include>
                                        <ns0:include>*.properties</ns0:include>
                                        <ns0:include>*.xml</ns0:include>
                                        <ns0:include>config/**</ns0:include>
                                    </ns0:includes>
                                </ns0:resource>
                            </ns0:resources>
                        </ns0:configuration>
                    </ns0:execution>
                </ns0:executions>
            </ns0:plugin>

            
            <ns0:plugin>
                <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                <ns0:artifactId>maven-assembly-plugin</ns0:artifactId>
                <ns0:version>3.6.0</ns0:version>
                <ns0:configuration>
                    <ns0:descriptors>
                        <ns0:descriptor>${devops.dir}/src/main/assembly/dist.xml</ns0:descriptor>
                    </ns0:descriptors>
                </ns0:configuration>
                <ns0:executions>
                    <ns0:execution>
                        <ns0:id>make-assembly</ns0:id>
                        <ns0:phase>package</ns0:phase>
                        <ns0:goals>
                            <ns0:goal>single</ns0:goal>
                        </ns0:goals>
                    </ns0:execution>
                </ns0:executions>
            </ns0:plugin>
        </ns0:plugins>
        <ns0:resources>
            <ns0:resource>
                <ns0:directory>src/main/resources</ns0:directory>
            </ns0:resource>
            <ns0:resource>
                <ns0:directory>src/main/java</ns0:directory>
                <ns0:includes>
                    <ns0:include>**/*.xml</ns0:include>
                </ns0:includes>
            </ns0:resource>
        </ns0:resources>
    </ns0:build>
</ns0:project>