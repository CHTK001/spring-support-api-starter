# OAuth 认证服务端环境变量模板。
#
# 用法：
#   install -d -m 0700 /etc/oauth
#   install -m 0600 deploy/oauth.env.example /etc/oauth/oauth.env
#   # 然后编辑 /etc/oauth/oauth.env，把 <...> 换成真实值
#
# 该文件由 oauth-server.service 的 EnvironmentFile 加载。
# 不要把本文件（含真实口令）提交进仓库。

# ---- oauth 自己的库（sys_user / sys_role / 令牌 / app_key 等）----
OAUTH_DB_HOST=127.0.0.1
OAUTH_DB_PORT=3306
OAUTH_DB_USER=<oauth库账号>
OAUTH_DB_PASSWORD=<oauth库口令>

# ---- 学生登录用的跨库通道（读 eduai 库的 edu_student）----
# 与主库分开是刻意的：两库结构已各自演进，合并有真实数据风险。
EDUAI_DB_HOST=127.0.0.1
EDUAI_DB_PORT=3306
EDUAI_DB_USER=<eduai库账号>
EDUAI_DB_PASSWORD=<eduai库口令>

# ---- 可选：Redis（默认 127.0.0.1:6379 db15，见 application-dev.yml）----
# SPRING_DATA_REDIS_HOST=127.0.0.1
# SPRING_DATA_REDIS_PORT=6379
