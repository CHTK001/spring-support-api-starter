    <select id="selectPermission" resultType="java.lang.String">
        SELECT
        sm.sys_menu_perm
        FROM
        sys_menu sm
        LEFT JOIN sys_role_menu srm ON sm.sys_menu_id = srm.sys_menu_id
        LEFT JOIN sys_role sr ON sr.sys_role_id = srm.sys_role_id
        LEFT JOIN sys_user_role sur ON sur.sys_role_id = sr.sys_role_id
        WHERE
        sm.sys_menu_type = 3
        AND sur.sys_user_id = #{userId}
        AND sm.sys_menu_perm IS NOT NULL
    </select>

    <select id="selectCustomOne" resultType="com.chua.starter.entity.system.SysUser">
        SELECT
            su.*,
            sug.copms_list
        FROM
            sys_user su
                LEFT JOIN sys_user_grid sug ON sug.user_id = su.sys_user_id
        WHERE su.sys_user_username = #{accessKey}
    </select>

    <select id="test" resultType="com.chua.starter.entity.system.SysUser">
        SELECT * FROM sys_user limit 1

    </select>

    <select id="selectOne" resultType="com.chua.starter.entity.system.SysUser">
        SELECT * FROM sys_user
        WHERE (sys_user_username = #{username} OR sys_user_phone = #{username})
        <if test="tenantId != null and tenantId != ''">
            AND sys_tenant_id = #{tenantId}
        </if>
    </select>
