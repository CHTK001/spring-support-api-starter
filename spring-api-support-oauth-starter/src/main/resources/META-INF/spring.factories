org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
  com.chua.starter.oauth.sso.support.configuration.EnableAuthServerConfiguration,\
  com.chua.starter.oauth.sso.support.configuration.EnableRedisTokenManagerConfiguration
org.springframework.boot.env.EnvironmentPostProcessor=\
  com.chua.starter.oauth.sso.support.configuration.EnableAuthServerConfiguration
# OAuth协议处理器SPI配置
com.chua.starter.oauth.sso.support.protocol.OAuthProtocolHandler=\
  com.chua.starter.oauth.sso.support.protocol.handler.CustomProtocolHandler,\
  com.chua.starter.oauth.sso.support.protocol.handler.JwtProtocolHandler,\
  com.chua.starter.oauth.sso.support.protocol.handler.JwtRsaProtocolHandler
  