<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.school.mapper.SchoolSyncConfigMapper">

    <!-- 学校同步配置的基本结果映射 -->
    <resultMap id="BaseResultMap" type="com.chua.starter.school.entity.SchoolSyncConfig">
        <id column="id" property="schoolSyncConfigId"/>
        <result column="school_code" property="schoolSyncConfigSchoolCode"/>
        <result column="school_name" property="schoolSyncConfigSchoolName"/>
        <result column="sync_type" property="schoolSyncConfigSyncType"/>
        <result column="sync_status" property="schoolSyncConfigSyncStatus"/>
        <result column="sync_time" property="schoolSyncConfigSyncTime"/>
        <result column="deleted" property="schoolSyncConfigDeleted"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_name" property="createName"/>
        <result column="update_name" property="updateName"/>
    </resultMap>
    
    <!-- 获取学校同步配置列表 -->
    <select id="getSchoolSyncConfigList" resultMap="BaseResultMap">
        SELECT 
            *
        FROM 
            school_sync_config
        WHERE 
            deleted = 0
        ORDER BY 
            create_time DESC
    </select>
    
    <!-- 根据学校代码获取同步配置 -->
    <select id="getSchoolSyncConfigBySchoolCode" resultMap="BaseResultMap">
        SELECT 
            *
        FROM 
            school_sync_config
        WHERE 
            school_code = #{schoolCode}
            AND deleted = 0
    </select>
    
    <!-- 根据同步类型获取同步配置列表 -->
    <select id="getSchoolSyncConfigBySyncType" resultMap="BaseResultMap">
        SELECT 
            *
        FROM 
            school_sync_config
        WHERE 
            sync_type = #{syncType}
            AND deleted = 0
        ORDER BY 
            create_time DESC
    </select>

    <select id="selectSyncConfigPage" resultType="com.chua.starter.school.entity.SchoolSyncConfig">
        SELECT * FROM school_sync_config
    </select>
</mapper>