<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.workflow.mapper.WfDefNodeMapper">

    <select id="selectByDefIdOrderBySort" resultType="com.chua.starter.workflow.entity.WfDefNode">
        SELECT * FROM wf_def_node
        WHERE wf_def_id = #{defId}
        ORDER BY node_sort ASC, wf_def_node_id ASC
    </select>

</mapper>
