<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.workflow.mapper.WfTaskHistoryMapper">

    <select id="selectByInstId" resultType="com.chua.starter.workflow.entity.WfTaskHistory">
        SELECT * FROM wf_task_history
        WHERE wf_inst_id = #{instId}
        ORDER BY create_time ASC
    </select>

</mapper>
