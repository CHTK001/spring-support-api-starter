<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
  <id>dist</id>
  <formats>
    <format>zip</format>
    <format>tar.gz</format>
  </formats>

  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>${project.artifactId}-${project.version}</baseDirectory>

  <fileSets>
    <!-- 主JAR文件 -->
    <fileSet>
      <directory>${project.build.directory}</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>${project.artifactId}-${project.version}.jar</include>
      </includes>
    </fileSet>

    <!-- 配置目录（由各模块构建阶段产出） -->
    <fileSet>
      <directory>${project.build.directory}/config</directory>
      <outputDirectory>/config</outputDirectory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>

    <!-- 依赖库目录（可选） -->
    <fileSet>
      <directory>${project.build.directory}/lib</directory>
      <outputDirectory>/lib</outputDirectory>
      <includes>
        <include>*.jar</include>
      </includes>
    </fileSet>

    <!-- 启动脚本统一来自 devops 模块（启用过滤替换 Maven 变量） -->
    <fileSet>
      <directory>${devops.dir}/src/main/bin</directory>
      <outputDirectory>/bin</outputDirectory>
      <includes>
        <include>*.sh</include>
        <include>*.bat</include>
        <include>*.cmd</include>
        <include>app.env</include>
      </includes>
      <fileMode>0755</fileMode>
      <lineEnding>unix</lineEnding>
      <filtered>true</filtered>
    </fileSet>

    <!-- Linux 子脚本 -->
    <fileSet>
      <directory>${devops.dir}/src/main/bin/script/linux</directory>
      <outputDirectory>/bin/script/linux</outputDirectory>
      <includes>
        <include>**/*.sh</include>
      </includes>
      <fileMode>0755</fileMode>
      <lineEnding>unix</lineEnding>
      <filtered>true</filtered>
    </fileSet>

    <!-- Windows 子脚本 -->
    <fileSet>
      <directory>${devops.dir}/src/main/bin/script/windows</directory>
      <outputDirectory>/bin/script/windows</outputDirectory>
      <includes>
        <include>**/*.bat</include>
        <include>**/*.cmd</include>
      </includes>
      <lineEnding>crlf</lineEnding>
      <filtered>true</filtered>
    </fileSet>

    <!-- Cluster 集群管理脚本 -->
    <fileSet>
      <directory>${devops.dir}/src/main/bin/script/cluster</directory>
      <outputDirectory>/bin/script/cluster</outputDirectory>
      <includes>
        <include>**/*.sh</include>
      </includes>
      <fileMode>0755</fileMode>
      <lineEnding>unix</lineEnding>
      <filtered>true</filtered>
    </fileSet>

    <!-- 文档（可选） -->
    <fileSet>
      <directory>${project.basedir}</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>README.md</include>
        <include>LICENSE</include>
        <include>CHANGELOG.md</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
