<?xml version="1.0" encoding="UTF-8" ?>
<Configuration monitorInterval="60" shutdownHook="disable">
    <Properties>
        <!-- 日志目录，支持通过系统属性覆盖 -->
        <Property name="LOG_PATH">${sys:logging.file.path:-./logs}</Property>
        <!-- 应用名，从系统属性获取 -->
        <Property name="APP_NAME">${sys:spring.application.name:-app}</Property>
        
        <!-- MDC 默认值 -->
        <Property name="DEFAULT_VALUE">N/A</Property>
        
        <!-- 控制台彩色日志格式 (包含 MDC) -->
        <Property name="CONSOLE_PATTERN">%style{[%d{yyyy-MM-dd HH:mm:ss}]}{red} %highlight{[%-5level]} %style{[%X{traceId:-}]}{yellow} %style{[%X{userId:-}]}{green} %style{[%X{requestIp:-}]}{magenta} %style{[%t]}{blue} %style{[%logger:%L]}{cyan} - %m%n%xEx</Property>
        <!-- 文件日志格式 (包含 MDC) -->
        <Property name="FILE_PATTERN">[%d{yyyy-MM-dd HH:mm:ss}] [%-5level] [%X{traceId:-}] [%X{userId:-}] [%X{requestIp:-}] [%t] [%logger:%L] - %m%n</Property>
    </Properties>

    <Appenders>
        <!-- 控制台输出 -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>

        <!-- 滚动文件输出 -->
        <RollingFile name="RollingFile" 
                     fileName="${LOG_PATH}/${APP_NAME}/app.log" 
                     filePattern="${LOG_PATH}/${APP_NAME}/%d{yyyy-MM-dd}.%i.log.gz"
                     append="true">
            <PatternLayout pattern="${FILE_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="200 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="30" compressionLevel="9">
                <Delete basePath="${LOG_PATH}/${APP_NAME}" maxDepth="2">
                    <IfFileName glob="*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 异步输出 (高性能) -->
        <Async name="Async" bufferSize="10000">
            <AppenderRef ref="RollingFile"/>
        </Async>
    </Appenders>

    <Loggers>
        <!-- 框架日志级别 -->
        <Logger name="org.apache.ibatis" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Async"/>
        </Logger>
        <Logger name="org.mybatis" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Async"/>
        </Logger>
        <Logger name="org.mybatis.spring.mapper" level="DEBUG" additivity="false">
            <AppenderRef ref="Async"/>
        </Logger>

        <Logger name="com.chua.starter.mybatis" level="DEBUG" additivity="false">
            <AppenderRef ref="Async"/>
        </Logger>

        <Logger name="com.zaxxer.hikari" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Async"/>
        </Logger>

        <Logger name="io.netty" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="org.burningwave" level="OFF" additivity="false"/>
        <Logger name="com.alibaba.nacos" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- 应用日志 -->
        <Logger name="com.chua" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Async"/>
        </Logger>

        <!-- 根日志 -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Async"/>
        </Root>
    </Loggers>

</Configuration>
