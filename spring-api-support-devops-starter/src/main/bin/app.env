#!/usr/bin/env sh
# 统一环境变量配置（可选）
# 注意：该文件会被 assembly 过滤替换 Maven 变量

# 应用名称与版本（用于日志前缀、PID 文件等）
APP_NAME=${project.artifactId}
APP_VERSION=${project.version}

# Java 时区（可选，默认使用系统时区）
# TIMEZONE="Asia/Shanghai"

# Java 文件编码（可选，默认 UTF-8）
# CHARSET="UTF-8"

# JVM 额外参数（可选）
# JVM_ARGS="-Xms512m -Xmx1024m"

# SkyWalking 探针配置（可选）
# 是否启用 SkyWalking 探针，启用后启动脚本会自动拼接 -javaagent
# SKYWALKING_ENABLED="false"

# SkyWalking 安装包下载地址（tar.gz），仅在本地未安装且启用时使用
# 例如: https://archive.apache.org/dist/skywalking/java-agent/8.16.0/apache-skywalking-java-agent-8.16.0.tgz
# SKYWALKING_DIST_URL=""

# SkyWalking 探针安装目录（默认为 <base>/agents/skywalking）
# SKYWALKING_AGENT_DIR=""

# SkyWalking 关键配置（会透传到 JVM -D 参数）
# SW_AGENT_NAME 默认使用 APP_NAME
# SW_AGENT_COLLECTOR_BACKEND_SERVICES 例如 127.0.0.1:11800
# SW_AGENT_INSTANCE_NAME 默认使用 主机名@PID

# Arthas 配置（可选）
# 是否在启动后自动附加 Arthas
# ARTHAS_ENABLED="false"

# Arthas 安装包下载地址（arthas-boot.jar），仅在本地未安装且启用时使用
# 例如: https://arthas.aliyun.com/download/arthas-boot.jar
# ARTHAS_BOOT_URL=""

# Arthas 安装目录（默认为 <base>/agents/arthas）
# ARTHAS_HOME=""

# Arthas 端口配置（可选）
# ARTHAS_TELNET_PORT="3658"
# ARTHAS_HTTP_PORT="8563"

# 备份目录配置（可选）
# 默认使用 <base>/backup，可设置为绝对路径或相对路径（相对于 <base>）
# 例如: BACKUP_DIR="/data/backup" 或 BACKUP_DIR="backups"
# BACKUP_DIR=

# 日志目录配置（可选）
# 默认使用 <base>/logs，可设置为绝对路径或相对路径（相对于 <base>）
# 例如: LOG_DIR="/data/logs" 或 LOG_DIR="logs"
# LOG_DIR=

# Jar文件名称配置（可选）
# 默认使用 <base>/<APP_NAME>-<APP_VERSION>.jar
# 如果指定，则使用该名称查找jar文件
# 例如: JAR_FILE_NAME="myapp-1.0.0.jar"
# JAR_FILE_NAME=

# 应用端口配置（可选）
# 通过 start.sh -p 设置，会作为 SERVER_PORT 环境变量传递给应用
# 例如: SERVER_PORT="8080"
# SERVER_PORT=

# ZGC 垃圾收集器配置（可选）
# 通过 start.sh --zgc 设置，启用 ZGC 垃圾收集器
# 例如: USE_ZGC="true"
# USE_ZGC=

# 堆内存大小配置（可选）
# 通过 start.sh --2g 或 start.sh --memory 2g 设置
# 例如: MEMORY_SIZE="2g" 或 MEMORY_SIZE="4g" 或 MEMORY_SIZE="512m"
# MEMORY_SIZE=

# Java 25 预览特性配置（可选）
# 通过 start.sh --enable-preview 设置，启用 Java 预览特性
# 例如: ENABLE_PREVIEW="true"
# ENABLE_PREVIEW=

# Java 模块配置（可选）
# 通过 start.sh --add-modules 设置，添加 Java 模块
# 例如: ADD_MODULES="java.base,java.sql"
# ADD_MODULES=

# Java 25 内存优化参数（默认开启，可通过设置为 false 禁用）
# UseCompactObjectHeaders: 启用紧凑对象头，减少对象头大小
# USE_COMPACT_OBJECT_HEADERS="true"

# UseCompressedOops: 启用压缩普通对象指针，在 64 位 JVM 上节省内存
# USE_COMPRESSED_OOPS="true"

# UseCompressedClassPointers: 启用压缩类指针，进一步减少内存占用
# USE_COMPRESSED_CLASS_POINTERS="true"

