#!/bin/bash
# ============================================================
# 集群配置文件
# 复制此文件为 cluster.conf 并根据实际情况修改
# ============================================================

# ===========================================
# 集群基本配置
# ===========================================
# 集群名称（用于标识）
CLUSTER_NAME="my-app-cluster"

# ===========================================
# 本地实例配置
# 在当前机器上启动的多个端口实例
# ===========================================
# 格式: 逗号分隔的端口号
# 示例: "8080,8081,8082"
# 留空表示不启动本地实例
LOCAL_PORTS="8080,8081"

# ===========================================
# 远程节点配置
# 格式: "别名|主机|端口|SSH用户|SSH端口|SSH密钥路径"
# 后面的字段可省略，使用默认值
# ===========================================
# 示例:
# REMOTE_NODES=(
#     "node1|192.168.1.10|8080"
#     "node2|192.168.1.11|8080|root"
#     "node3|192.168.1.12|8080|deploy|22|/home/deploy/.ssh/id_rsa"
# )
REMOTE_NODES=(
    # "node1|192.168.1.10|8080"
    # "node2|192.168.1.11|8080"
)

# ===========================================
# SSH 默认配置
# ===========================================
DEFAULT_SSH_USER="root"
DEFAULT_SSH_PORT="22"
# SSH 密钥路径，留空使用系统默认
DEFAULT_SSH_KEY=""
# SSH 连接超时（秒）
SSH_TIMEOUT="10"

# ===========================================
# 远程路径配置
# ===========================================
# 远程应用部署目录
# 支持变量: ${APP_NAME}
REMOTE_APP_HOME="/opt/apps/\${APP_NAME}"

# 远程启动脚本路径
REMOTE_STARTUP_SCRIPT="\${REMOTE_APP_HOME}/bin/startup.sh"

# ===========================================
# 升级配置
# ===========================================
# 滚动升级间隔（秒）
ROLLING_UPGRADE_INTERVAL="10"

# 升级前是否自动备份
AUTO_BACKUP_BEFORE_UPGRADE="true"

# 健康检查重试次数
HEALTH_CHECK_RETRIES="30"

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL="2"

# ===========================================
# 健康检查配置
# ===========================================
# 健康检查端点路径
HEALTH_CHECK_PATH="/actuator/health"

# 健康检查协议 (http/https)
HEALTH_CHECK_PROTOCOL="http"

# ===========================================
# 日志配置
# ===========================================
# 聚合日志时显示的最大行数
AGGREGATE_LOG_LINES="50"
