<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.system.mapper.SysRoleMenuMapper">
  <resultMap id="BaseResultMap" type="com.chua.starter.entity.system.SysRoleMenu">
    <!--@mbg.generated-->
    <!--@Table sys_role_menu-->
    <id column="sys_role_menu_id" jdbcType="INTEGER" property="sysRoleMenuId" />
    <result column="sys_role_id" jdbcType="INTEGER" property="sysRoleId" />
    <result column="sys_menu_id" jdbcType="INTEGER" property="sysMenuId" />
  </resultMap>
  <sql id="Base_Column_List">
    <!--@mbg.generated-->
    sys_role_menu_id, sys_role_id, sys_menu_id
  </sql>

  <!--
      一次性取回「全部角色-菜单绑定」并带出角色码。
      <p>为什么需要它：菜单按用户过滤时要同时判断两件事 —— ①这份菜单是否绑给了我的角色、
      ②这份菜单有没有被任何角色绑定过（没绑过视为公共菜单）。拆成两条 SQL 就是多一次
      全表扫描，这里用一条联表查询同时满足。</p>
      <p>只取两列（菜单 id + 角色码），不必加载实体其它字段。角色被删但关联残留时
      {@code roleCode} 为 {@code null}，调用方需容忍。</p>
  -->
  <select id="selectRoleMenuBindings" resultType="com.chua.starter.system.pojo.menu.RoleMenuBinding">
    SELECT rm.sys_menu_id AS menuId, r.sys_role_code AS roleCode
    FROM sys_role_menu rm
    LEFT JOIN sys_role r ON r.sys_role_id = rm.sys_role_id
  </select>
</mapper>