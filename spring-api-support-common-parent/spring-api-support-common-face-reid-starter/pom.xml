<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-api-support-common-parent</artifactId>
    <version>4.0.0.42</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>spring-api-support-common-face-reid-starter</artifactId>
  <description>通用人脸重识别(Re-ID) - 跨摄像头/跨帧同一人脸追踪, 特征库检索与聚类(SPI + 本地实现)</description>
  <dependencies>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-common-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-swagger-starter</artifactId>
    </dependency>
    <!--
      控制器的 @Tag / @Operation 来自 OpenAPI v3 注解（io.swagger.v3.oas.annotations）。
      工程内其他模块经由 service-starter 传递获得它；本模块不引入 service-starter，
      故在此显式声明 Jakarta 版本（Spring Boot 3+ / 4.x 使用 jakarta 命名空间）。
    -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
      <version>2.2.19</version>
    </dependency>
    <!--
      配置数据库存储（sys_setting）：刻意不引入 spring-api-support-common-service-starter。
      该依赖会连带 MyBatis-Plus / Redis / GeoIP 整套数据层，而本模块仅用它
      「可选地持久化若干项配置」。SysSettingStore 改为运行期弱耦合适配：
      宿主具备配置服务时自动生效，否则回退 application 配置，识别链路不受影响。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
