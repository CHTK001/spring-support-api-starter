<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.signin.mapper.SignInPointsRuleMapper">

    <select id="selectByStatus" resultType="com.chua.starter.signin.model.SignInPointsRule">
        SELECT * FROM sign_in_points_rule WHERE status = #{status} ORDER BY points DESC
    </select>
</mapper>