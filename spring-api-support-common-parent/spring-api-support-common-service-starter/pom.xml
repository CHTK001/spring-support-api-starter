<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-api-parent</artifactId>
    <version>4.0.0.42</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>spring-api-support-common-service-starter</artifactId>
  <description>通用服务模块，提供基础服务支持能力，包括OAuth认证、通用实体管理等功能</description>
  <name>Spring API Support Common Service Starter</name>
  <dependencies>
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
      <version>1.9.24</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-entity-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-oauth-client-starter</artifactId>
    </dependency>
    <!-- 顶栏天气 / 定位 / 台风（/v2/weather、/v2/location、/v2/typhoon）：
         实现已下沉到 spring 层共享模块，本模块只做依赖引入（自动配置注册控制器）。
         版本显式写出：本模块的 parent relativePath 指向的是 common-parent（坐标不匹配），
         Maven 会回落到仓库里的 api-parent pom，依赖管理里的版本可能陈旧。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasearch-starter</artifactId>
      <version>${module.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-configuration-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-filesystem-starter</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-ratelimiter</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-annotations</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-socket-io-starter</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-ssh-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-redis-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-job-starter</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.swagger</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
<artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    </dependencies>
</project>
