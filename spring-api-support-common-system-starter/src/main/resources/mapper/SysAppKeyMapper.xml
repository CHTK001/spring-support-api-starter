<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.system.mapper.SysAppKeyMapper">

    <resultMap id="BaseResultMap" type="com.chua.starter.entity.system.SysAppKey">
        <id column="sys_app_key_id" jdbcType="INTEGER" property="sysAppKeyId"/>
        <result column="sys_app_key_app_id" jdbcType="VARCHAR" property="sysAppKeyAppId"/>
        <result column="sys_app_key_secret" jdbcType="VARCHAR" property="sysAppKeySecret"/>
        <result column="sys_app_key_name" jdbcType="VARCHAR" property="sysAppKeyName"/>
        <result column="sys_user_id" jdbcType="INTEGER" property="sysUserId"/>
        <result column="sys_app_key_status" jdbcType="INTEGER" property="sysAppKeyStatus"/>
        <result column="sys_app_key_delete" jdbcType="INTEGER" property="sysAppKeyDelete"/>
        <result column="sys_app_key_expire_time" jdbcType="BIGINT" property="sysAppKeyExpireTime"/>
        <result column="sys_app_key_ip_whitelist" jdbcType="VARCHAR" property="sysAppKeyIpWhitelist"/>
        <result column="sys_app_key_remark" jdbcType="VARCHAR" property="sysAppKeyRemark"/>
        <result column="sys_app_key_last_used_time" jdbcType="BIGINT" property="sysAppKeyLastUsedTime"/>
        <result column="sys_app_key_use_count" jdbcType="INTEGER" property="sysAppKeyUseCount"/>
        <result column="create_name" jdbcType="VARCHAR" property="createName"/>
        <result column="create_by" jdbcType="INTEGER" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="update_name" jdbcType="VARCHAR" property="updateName"/>
        <result column="update_by" jdbcType="INTEGER" property="updateBy"/>
    </resultMap>

    <sql id="Base_Column_List">
        sys_app_key_id, sys_app_key_app_id, sys_app_key_secret, sys_app_key_name,
        sys_user_id, sys_app_key_status, sys_app_key_delete, sys_app_key_expire_time,
        sys_app_key_ip_whitelist, sys_app_key_remark, sys_app_key_last_used_time, sys_app_key_use_count,
        create_name, create_by, create_time, update_time, update_name, update_by
    </sql>

    <!-- 根据 appId 查询 -->
    <select id="selectByAppId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_app_key
        WHERE sys_app_key_app_id = #{appId}
          AND sys_app_key_delete = 0
    </select>

    <!-- 根据 appKey(密钥) 查询 -->
    <select id="selectByAppKey" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_app_key
        WHERE sys_app_key_secret = #{appKey}
          AND sys_app_key_delete = 0
    </select>

</mapper>
