<?xml version='1.0' encoding='utf-8'?>
<ns0:project xmlns:ns0="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <ns0:modelVersion>4.0.0</ns0:modelVersion>
    <ns0:parent>
        <ns0:groupId>com.chua</ns0:groupId>
        <ns0:artifactId>spring-support-api-parent</ns0:artifactId>
        <ns0:version>${project.version}</ns0:version>
    </ns0:parent>

    <ns0:artifactId>spring-api-support-common-system-starter</ns0:artifactId>
    <ns0:name>Spring API Support Common System Starter</ns0:name>
    <ns0:description>基础功能模块 - 提供系统通用功能支持，包括配置管理、服务发现、Excel处理、Swagger文档、MyBatis集成等核心组件
    </ns0:description>

    <ns0:properties>
        <ns0:maven.compiler.source>25</ns0:maven.compiler.source>
        <ns0:maven.compiler.target>25</ns0:maven.compiler.target>
        <ns0:project.build.sourceEncoding>UTF-8</ns0:project.build.sourceEncoding>
    </ns0:properties>

    <ns0:dependencies>
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-api-support-common-entity-starter</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-api-support-common-service-starter</ns0:artifactId>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-oauth-client-starter</ns0:artifactId>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-datasource-starter</ns0:artifactId>
            <ns0:optional>true</ns0:optional>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-redis-starter</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>org.springframework.boot</ns0:groupId>
            <ns0:artifactId>spring-boot-starter-data-redis</ns0:artifactId>
            <ns0:exclusions>
                <ns0:exclusion>
                    <ns0:artifactId>spring-boot-starter-logging</ns0:artifactId>
                    <ns0:groupId>org.springframework.boot</ns0:groupId>
                </ns0:exclusion>
            </ns0:exclusions>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>redis.clients</ns0:groupId>
            <ns0:artifactId>jedis</ns0:artifactId>
            </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-swagger-starter</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-mybatis-starter</ns0:artifactId>
        </ns0:dependency>

        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-api-support-common-configuration-starter</ns0:artifactId>
        </ns0:dependency>

        
        <ns0:dependency>
            <ns0:groupId>com.chua</ns0:groupId>
            <ns0:artifactId>spring-support-tencent-starter</ns0:artifactId>
            <ns0:optional>true</ns0:optional>
        </ns0:dependency>
    </ns0:dependencies>

    <ns0:build>
        <ns0:plugins>
            <ns0:plugin>
                <ns0:groupId>org.apache.maven.plugins</ns0:groupId>
                <ns0:artifactId>maven-compiler-plugin</ns0:artifactId>
                <ns0:configuration>
                    <ns0:source>25</ns0:source>
                    <ns0:target>25</ns0:target>
                </ns0:configuration>
            </ns0:plugin>
        </ns0:plugins>

        <ns0:resources>
            <ns0:resource>
                <ns0:directory>src/main/resources</ns0:directory>
                <ns0:includes>
                    <ns0:include>**/*</ns0:include>
                </ns0:includes>
            </ns0:resource>
        </ns0:resources>
    </ns0:build>

</ns0:project>