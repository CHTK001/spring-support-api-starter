# Collect exec node. Generated by collect-ops/units-roles-198.sh.
# Type=forking + PIDFile: run-exec.sh backgrounds java itself and writes the pid file.
# ExecStop sends SIGTERM and waits instead of calling stop.sh: stop.sh does
# kill -> sleep 2 -> kill -9, and the app needs 30-40s to stop (it releases the leader lease
# in the FIRST stop phase), so a 2s SIGKILL skips the release and leaves a dispatch gap
# until the lease TTL expires.
#
# 2026-10-02 修正：原 StandardOutput/StandardError 写的是 append:/opt/collect/logs/.log
#   —— 生成器里的角色名变量没展开，于是 stdout/stderr 落进一个**隐藏文件** .log，
#   且 collect-exec 与 collect-sched **共用同一个 .log**，两个节点的输出混在一起。
#   run-exec.sh 自己把 java 分流到 exec_out.log / exec_err.log，故 wrapper 的输出
#   应归位到同名文件（这两个文件已在 logrotate/collect 管辖内，无需新增轮转项）。
#   ⚠ 生成器 collect-ops/units-roles-198.sh 若不同步修改，下次生成会重新引入 .log。
[Unit]
Description=Collect exec node (role port 18192)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/opt/collect/data/exec.pid
WorkingDirectory=/opt/collect
ExecStart=/opt/collect/run-exec.sh
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=75
# run-exec.sh backgrounds java, so the tracked main process exits 143 on SIGTERM.
# Without this line systemd records every intentional stop as Result: exit-code -> "failed".
SuccessExitStatus=143
StandardOutput=append:/opt/collect/logs/exec_out.log
StandardError=append:/opt/collect/logs/exec_err.log

[Install]
WantedBy=multi-user.target