# Collect sched node. Generated by collect-ops/units-roles-198.sh.
# Type=forking + PIDFile: run-sched.sh backgrounds java itself and writes the pid file.
# ExecStop sends SIGTERM and waits instead of calling stop.sh: stop.sh does
# kill -> sleep 2 -> kill -9, and the app needs 30-40s to stop (it releases the leader lease
# in the FIRST stop phase), so a 2s SIGKILL skips the release and leaves a dispatch gap
# until the lease TTL expires.
#
# 2026-10-02 修正：同 collect-exec —— 原 append:/opt/collect/logs/.log 的角色名变量未展开，
#   且与 collect-exec 共用同一个隐藏 .log；改为本节点的 sched_out.log / sched_err.log。
#   ⚠ 生成器 collect-ops/units-roles-198.sh 需同步修改，否则会回归。
[Unit]
Description=Collect sched node (role port 18191)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/opt/collect/data/sched.pid
WorkingDirectory=/opt/collect
ExecStart=/opt/collect/run-sched.sh
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=75
# run-sched.sh backgrounds java, so the tracked main process exits 143 on SIGTERM.
# Without this line systemd records every intentional stop as Result: exit-code -> "failed".
SuccessExitStatus=143
StandardOutput=append:/opt/collect/logs/sched_out.log
StandardError=append:/opt/collect/logs/sched_err.log

[Install]
WantedBy=multi-user.target