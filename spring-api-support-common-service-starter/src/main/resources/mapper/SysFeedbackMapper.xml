<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.service.mapper.SysFeedbackMapper">

    <select id="pageFor" resultType="com.chua.starter.system.entity.SysFeedback">
        SELECT * FROM
        sys_feedback sf
        <where>
            <if test="request.sysFeedbackType != null and request.sysFeedbackType != ''">
                AND sf.sys_feedback_type = #{request.sysFeedbackType }
            </if>

            <if test="request.sysFeedbackStatus != null">
                AND sf.sys_feedback_status = #{request.sysFeedbackStatus }
            </if>

            <if test="request.startTime != null and request.endTime != null">
                AND sf.create_time BETWEEN #{request.startTime} AND #{request.endTime}
            </if>
        </where>
    </select>
</mapper>