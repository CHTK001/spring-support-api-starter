<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!--
     * @author: CH
     * @date: 2024-08-20
     *
     * 项目名称: spring-api-support-common-service-starter
     * 模块描述: 通用服务模块
     *
     * 入参说明:
     *   - maven.compiler.source: 指定源代码的Java版本，例如: 25
     *   - maven.compiler.target: 指定编译后的Java版本，例如: 25
     *   - project.build.sourceEncoding: 指定项目构建时使用的源码编码格式，例如: UTF-8
     *
     * 依赖说明:
     *   - spring-support-common-starter: 提供基础公共功能支持
     *   - spring-support-oauth-client-starter: 提供OAuth客户端支持
     -->
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-api-parent</artifactId>
        <version>4.0.0</version>
    </parent>

    <artifactId>spring-api-support-common-service-starter</artifactId>
    <description>通用服务模块，提供基础服务支持能力，包括OAuth认证、通用实体管理等功能</description>
    <name>Spring API Support Common Service Starter</name>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-api-support-common-entity-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-api-support-common-configuration-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-ratelimiter</artifactId>
            <version>2.2.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-annotations</artifactId>
            <version>2.2.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Socket.IO 支持（可选依赖）
             用于消息实时推送功能，如果不需要WebSocket推送可不引入 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-io-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Redis支持 - 必需（SimpleSysUserService需要） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-redis-starter</artifactId>
        </dependency>

        <!-- Job支持（可选依赖）
             用于文件清理定时任务等功能 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-job-starter</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>