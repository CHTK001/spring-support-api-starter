<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-api-parent</artifactId>
    <version>4.0.0.41</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>spring-api-support-protocol-test-starter</artifactId>
  <name>spring-api-support-protocol-test-starter</name>
  <description>Protocol 管理真实联调测试后端</description>

  <dependencies>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-protocol-starter</artifactId>
      <version>${module.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-monitor-starter</artifactId>
      <version>${module.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.logging.log4j</groupId>
          <artifactId>log4j-slf4j2-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-common-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-protocol-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-netty-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-ftp-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-ssh-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- sshd-core provided by utils-support-ssh-starter, re-declare for runtime -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>3.0.0-M2</version>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>3.0.0-M2</version>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-scp</artifactId>
      <version>3.0.0-M2</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
