com.chua.starter.system.SystemApplication
com.chua.starter.system.SystemApplication
--spring.profiles.active=h2
--spring.datasource.driver-class-name=org.h2.Driver
--spring.datasource.url=jdbc:h2:file:./data/system_h2;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
--spring.datasource.username=sa
--spring.datasource.password=
--spring.sql.init.mode=never
--plugin.oauth.protocol=static
--plugin.redis.server.enable=false
--plugin.sync.server.enable=false
--plugin.sync.client.enable=false
--plugin.report.client.enable=false
--spring.main.banner-mode=off
--plugin.oauth.local-admin-fallback=true
