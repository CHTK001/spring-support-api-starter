<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-api-parent</artifactId>
    <version>4.0.0.51</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>spring-api-support-collect-scheduler-starter</artifactId>
  <description>采集调度系统：采集与调度两个平级系统的可部署载体（启动类 + 调度控制台出口），
    依赖采集模块 spring-support-collect-starter 与调度模块 spring-support-job-starter。
    采集能力与调度台账分别由两个被依赖模块提供，本模块只做装配与打包，不含业务实现。</description>

  <dependencies>
    <!-- 采集模块：流程编排 / 执行引擎 / 任务与结果 / 变量与函数 / 通知 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-collect-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- OSGi 插件框架：/osgi/** 提供 bundle 清单与上传安装/升级/启停/卸载/下载，
         前端「插件中心」直接使用。Felix 启动失败只记日志、不阻断采集与调度。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-osgi-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 调度模块：@Job + Scheduler/Executor/SINGLE 多模式，提供 sys_job 台账与治理服务。
         显式声明而非依赖传递：调度是本系统与采集平级的另一半，不是采集的附属能力。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-job-starter</artifactId>
    </dependency>
    <!-- 租户契约：datasource-hub 的 DatasourceTenantLookupAdapter 实现
         TenantDatasourceLookup，而 hub 把 tenant-starter 声明为 optional，不随依赖传递。
         本应用内嵌 hub，必须自带 tenant 的类，否则 Spring 解析该适配器时会因
         TenantDatasourceLookup 缺失而启动失败。
         注意：这里只提供契约类，不扫描 com.chua.starter.tenant，也不启用租户服务端；
         采集应用没有租户管理面，扫描后反而会要求 SysServiceMapper 等租户专属 Bean。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-api-support-common-tenant-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- datasource-hub（内嵌）新版 DbConsoleController 的构造参数泛型引用了
         com.chua.starter.ai.support.service.AiChatFacadeService；hub 把 ai-starter
         声明为 optional（不传递），不显式引入则 Spring 解析方法参数通用类型时抛
         TypeNotPresentException，整个上下文启动失败。可部署形态必须自带 ai 模块，
         与 8081 中心（app.jar 含 ai）口径一致。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-ai-starter</artifactId>
    </dependency>
    <!-- 站内消息渠道说明：走的是采集模块传递依赖的 common-system-starter 消息中心，
         本模块无需（也不该）再引 spring-support-message-starter —— 后者与
         common-system-starter 各自带了一整套 SysMessage*，4 个 Mapper 与 4 组
         Service/Impl 同名，共存会让 Spring 上下文启动失败。 -->
    <!-- 可部署形态自带驱动：外部库与零依赖演示两种启动方式都开箱可用 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        可执行薄 jar：classpath 指向 lib/，配置外置到 config/。
        这套打包原先挂在采集模块上，但采集是库、不该背启动类与部署形态，
        故随启动类一并上移到本系统模块。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>*.yml</exclude>
            <exclude>*.yaml</exclude>
            <exclude>*.properties</exclude>
            <exclude>logback*.xml</exclude>
            <exclude>log4j2*.xml</exclude>
            <exclude>config/**</exclude>
          </excludes>
          <archive>
            <manifest>
              <mainClass>com.chua.starter.collect.scheduler.CollectApplication</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
            <manifestEntries>
              <Class-Path>config/</Class-Path>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <excludeTransitive>false</excludeTransitive>
              <stripVersion>false</stripVersion>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/config</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/resources</directory>
                  <includes>
                    <include>*.yml</include>
                    <include>*.yaml</include>
                    <include>*.properties</include>
                    <include>logback*.xml</include>
                    <include>log4j2*.xml</include>
                    <include>config/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
