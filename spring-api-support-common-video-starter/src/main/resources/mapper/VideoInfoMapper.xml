<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.video.mapper.VideoInfoMapper">
    <!-- 搜索视频 -->
    <select id="searchVideos" resultType="com.chua.starter.video.entity.VideoInfo">
        SELECT *
        FROM video_info
        <trim>
            <where>
                video_status = 0
                <if test="request.keyword != null and request.keyword != ''">
                    AND (
                        video_title LIKE CONCAT('%', #{request.keyword}, '%')
                            OR video_description LIKE CONCAT('%', #{request.keyword}, '%')
                            OR video_author LIKE CONCAT('%', #{request.keyword}, '%')
                        )
                </if>

                <if test="request.category != null and request.category != ''">
                    AND video_category = #{request.category}
                </if>

                <if test="request.selectedType != null and request.selectedType != ''">
                    AND (
                    <foreach collection="request.selectedType.split(',')" item="type" separator=" AND " open="("
                             close=")">
                        FIND_IN_SET(#{type}, video_type)
                    </foreach>
                    )
                </if>

                <!-- 多地区筛选 -->
                <if test="request.districts != null and request.districts != ''">
                    AND (
                    <foreach collection="request.districts.split(',')" item="district" separator=" OR " open="("
                             close=")">
                        FIND_IN_SET(#{district}, video_district)
                    </foreach>
                    )
                </if>

                <!-- 多语言筛选 -->
                <if test="request.languages != null and request.languages != ''">
                    AND (
                    <foreach collection="request.languages.split(',')" item="language" separator=" OR " open="("
                             close=")">
                        FIND_IN_SET(#{language}, video_language)
                    </foreach>
                    )
                </if>

                <!-- 多类型筛选 -->
                <if test="request.videoTypes != null and request.videoTypes != ''">
                    AND (
                    <foreach collection="request.videoTypes.split(',')" item="videoType" separator=" AND " open="("
                             close=")">
                        FIND_IN_SET(#{videoType}, video_type)
                    </foreach>
                    )
                </if>


                <!-- 上映年份筛选，支持多个年份 -->
                <if test="request.years != null and request.years != ''">
                    AND (
                    <foreach collection="request.years.split(',')" item="year" separator=" OR " open="(" close=")">
                        FIND_IN_SET(#{year}, video_year)
                    </foreach>
                    )
                </if>
            </where>
            <if test="request.order != null">
                <choose>
                    <when test="request.order == 'videoScore desc'">
                        ORDER BY video_score DESC
                    </when>

                    <when test="request.order == 'videoScore asc'">
                        ORDER BY video_score ASC
                    </when>

                    <when test="request.order == 'videoViews desc' or request.order == 'recommend'">
                        ORDER BY video_views DESC
                    </when>

                    <when test="request.order == 'videoViews asc'">
                        ORDER BY video_views ASC
                    </when>

                    <when test="request.order == 'videoPublishDate desc' or request.order == 'newest'">
                        ORDER BY video_publish_date DESC
                    </when>

                    <when test="request.order == 'videoPublishDate asc'">
                        ORDER BY video_publish_date ASC
                    </when>

                    <when test="request.order == 'videoYear desc'">
                        ORDER BY video_ear DESC
                    </when>

                    <when test="request.order == 'videoYear asc'">
                        ORDER BY video_ear ASC
                    </when>

                    <when test="request.order == 'videoLikes desc'">
                        ORDER BY video_likes DESC
                    </when>

                    <when test="request.order == 'videoLikes asc'">
                        ORDER BY video_likes ASC
                    </when>

                    <when test="request.order == 'createTime desc'">
                        ORDER BY create_time DESC
                    </when>

                    <when test="request.order == 'createTime asc'">
                        ORDER BY create_time ASC
                    </when>

                    <when test="request.order == 'updateTime desc'">
                        ORDER BY update_time DESC
                    </when>

                    <when test="request.order == 'updateTime asc'">
                        ORDER BY update_time ASC
                    </when>

                    <otherwise>
                        ORDER BY video_id DESC
                    </otherwise>
                </choose>
            </if>
        </trim>
    </select>
</mapper>